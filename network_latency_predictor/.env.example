# Network Latency Predictor — Environment Variables
# Copy this file to .env and adjust values as needed.

# Collector
NETWORK_INTERFACE=eth0
PROBE_HOSTS=["8.8.8.8","1.1.1.1","208.67.222.222"]
PROBE_INTERVAL_SEC=1.0
CAPTURE_FILTER=icmp or tcp

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=network.telemetry.raw
KAFKA_TOPIC_FEATURES=network.telemetry.features
KAFKA_TOPIC_PREDICTIONS=network.predictions

# Feature windows (seconds)
WINDOW_SHORT=5
WINDOW_MEDIUM=30
WINDOW_LONG=300

# EWMA
EWMA_ALPHA=0.3

# Model
MODEL_DIR=./models/saved
ENSEMBLE_WEIGHTS={"arima":0.2,"xgboost":0.4,"lstm":0.3,"queuing":0.1}

# API
API_HOST=0.0.0.0
API_PORT=8000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=network_latency_prediction

# Drift detection
DRIFT_THRESHOLD_MAE=5.0
DRIFT_WINDOW_SIZE=500
